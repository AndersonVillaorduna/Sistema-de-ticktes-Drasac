# ── Seguridad (OBLIGATORIAS en producción). Genera cada una con:
#    python -c "import secrets; print(secrets.token_hex(32))" ──
SECRET_KEY=cambia-esto-por-una-llave-aleatoria
JWT_SECRET_KEY=cambia-esto-por-otra-llave-aleatoria

# development | production
FLASK_ENV=development

# Orígenes autorizados para CORS (tu frontend), separados por coma
CORS_ORIGINS=https://tu-frontend.vercel.app

# ── Base de datos (producción: MySQL/PostgreSQL) ──
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://usuario:password@host:3306/drasac

# ── IA (Ollama) ──
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_THREAD=0

# ── Escalado (producción) ──
# Almacenamiento del limitador de peticiones compartido entre workers:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
