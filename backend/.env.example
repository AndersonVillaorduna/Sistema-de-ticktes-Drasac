# Crear backend/.env a partir de este archivo. No reutilizar llaves de ejemplo.
# Generar SECRET_KEY y JWT_SECRET_KEY por separado con secrets.token_hex(32).
SECRET_KEY=
JWT_SECRET_KEY=
# Generar con cryptography.fernet.Fernet.generate_key().decode().
# Primera llave = nueva escritura; las siguientes permiten leer respaldos antiguos.
INVENTORY_ENCRYPTION_KEYS=
FLASK_ENV=development
FLASK_DEBUG=0
SQLALCHEMY_DATABASE_URI=sqlite:///drasac.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
JWT_EXPIRA_HORAS=12
JWT_COOKIE_SAMESITE=Lax
# Producción requiere Redis y HTTPS. Conectar solo a un proxy confiable conocido.
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
WEB_CONCURRENCY=4
WEB_THREADS=8
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_THREAD=0
OLLAMA_MAX_CONCURRENTES=2
OLLAMA_TIMEOUT=60
UPLOAD_DAILY_QUOTA_MB=200
UPLOAD_USER_QUOTA_MB=100
UPLOAD_RETENTION_DAYS=60
UPLOAD_LINK_TTL=3600
